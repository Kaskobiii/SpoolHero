@page "/settings/printer-integration"
@page "/printers/connection"
@inject NavigationManager Navigation
@inject PrinterService Printers

@code {
    protected override async Task OnInitializedAsync()
    {
        List<PrinterDto>? printers = null;
        try { printers = await Printers.GetAllAsync(); }
        catch (HttpRequestException) { }
        Navigation.NavigateTo(printers?.Count == 1 ? $"/printers/{printers[0].Id}" : "/printers", replace: true);
    }
}
