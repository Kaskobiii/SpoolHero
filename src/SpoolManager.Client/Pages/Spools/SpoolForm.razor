@page "/spools/new"
@page "/spools/{Id:guid}/edit"

<PageTitle>@(Id.HasValue ? L["spool.edit"] : L["spool.add"]) – @L["app.name"]</PageTitle>

<div class="page-header">
    <h1><i class="bi bi-archive me-2"></i>@(Id.HasValue ? L["spool.edit"] : L["spool.add"])</h1>
</div>

@if (_loading) { <div class="text-center py-5"><div class="spinner-border"></div></div> }
else
{
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            @if (!Id.HasValue && _nfcAvailable)
            {
                <div class="card mb-3 border-info">
                    <div class="card-body py-2">
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <div class="flex-grow-1">
                                <strong><i class="bi bi-broadcast me-1 text-info"></i>@L["spool.nfc.import.title"]</strong>
                                <div class="text-muted small">@L["spool.nfc.import.hint"]</div>
                            </div>
                            @if (_nfcReading)
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <div class="spinner-border spinner-border-sm text-info"></div>
                                    <span class="text-muted small">@L["spool.nfc.scanning"]</span>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="StopNfcScanAsync">@L["common.cancel"]</button>
                                </div>
                            }
                            else
                            {
                                <button class="btn btn-outline-info btn-sm" @onclick="StartNfcScanAsync">
                                    <i class="bi bi-phone me-1"></i>@L["spool.nfc.import.scan"]
                                </button>
                            }
                        </div>
                        @if (_nfcImportError != null)
                        {
                            <div class="alert alert-warning py-1 mt-2 mb-0 small">@_nfcImportError</div>
                        }
                        @if (_nfcImportSuccess)
                        {
                            <div class="alert alert-success py-1 mt-2 mb-0 small">
                                <i class="bi bi-check-circle me-1"></i>@L["spool.nfc.import.done"]
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="card">
                <div class="card-body">
                    @if (_error != null) { <div class="alert alert-danger">@_error</div> }

                    <div class="mb-3">
                        <label class="form-label">@L["spool.material"] *</label>
                        <MaterialPicker Value="_form.FilamentMaterialId == Guid.Empty ? null : _form.FilamentMaterialId"
                                        OnSelected="OnMaterialPicked" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="spool-remaining-grams">@L["spool.remaining.grams"] *</label>
                        <input id="spool-remaining-grams" class="form-control" type="number" inputmode="decimal" step="0.1" min="0"
                               @bind="_form.RemainingWeightGrams" />
                    </div>

                    <div class="mb-3">
                        <div class="form-text mb-2">@L["spool.remaining.grams.hint"]</div>
                        <label class="form-label mt-2" for="spool-initial-weight">@L["spool.initial.weight"] @L["common.optional"]</label>
                        <input id="spool-initial-weight" class="form-control" type="number" inputmode="decimal" step="0.1" min="0"
                               @bind="_form.InitialWeightGrams" />
                        <div class="form-text mb-3">@L["spool.initial.weight.hint"]</div>
                        <label class="form-label" for="spool-empty-weight">@L["spool.empty.weight"] @L["common.optional"]</label>
                        <input id="spool-empty-weight" class="form-control" type="number" inputmode="decimal" step="0.1" min="0"
                               @bind="_form.EmptySpoolWeightGrams" />
                        <div class="form-text">@L["spool.empty.weight.hint"]</div>
                    </div>
                    @if (_form.EmptySpoolWeightGrams is >= 0)
                    {
                        <div class="border rounded p-3 mb-3">
                            <label class="form-label" for="spool-weighed-total">@L["spool.weighed.total"]</label>
                            <div class="d-flex flex-wrap align-items-end gap-2">
                                <input id="spool-weighed-total" class="form-control spool-weighed-input" type="number" inputmode="decimal" step="0.1" min="0"
                                       @bind="_weighedTotalGrams" />
                                <button type="button" class="btn btn-outline-primary" disabled="@(!CanApplyWeighedTotal)" @onclick="ApplyWeighedTotal">@L["spool.calculate.remaining"]</button>
                            </div>
                            <div class="form-text">@L["spool.weighed.total.hint"]</div>
                        </div>
                    }

                    <fieldset class="mb-3 spool-choice-fieldset">
                        <legend class="form-label">@L["spool.location"]</legend>
                        <div class="spool-choice-buttons mb-2">
                            <button type="button" class="btn spool-choice-button @(HasNoLocation ? "btn-primary" : "btn-outline-secondary")"
                                    aria-pressed="@(HasNoLocation.ToString().ToLowerInvariant())" @onclick='() => OnLocationChange(null, null)'>
                                <i class="bi bi-check-lg spool-choice-check" style="visibility:@(HasNoLocation ? "visible" : "hidden")" aria-hidden="true"></i>
                                <span>@L["spool.location.unassigned"]</span>
                            </button>
                        </div>
                        @if (_printers.Count > 0)
                        {
                            <div class="form-label small text-muted mb-1" id="spool-printer-options">@L["spool.printer"]</div>
                            <div class="spool-choice-buttons mb-2" role="group" aria-labelledby="spool-printer-options">
                                @foreach (var p in _printers)
                                {
                                    <button type="button" class="btn spool-choice-button @(_form.PrinterId == p.Id ? "btn-primary" : "btn-outline-secondary")"
                                            aria-pressed="@((_form.PrinterId == p.Id).ToString().ToLowerInvariant())" @onclick='() => OnLocationChange("printer", p.Id)'>
                                        <i class="bi bi-check-lg spool-choice-check" style="visibility:@(_form.PrinterId == p.Id ? "visible" : "hidden")" aria-hidden="true"></i>
                                        <span>@p.Name</span>
                                    </button>
                                }
                            </div>
                        }
                        @if (_storages.Count > 0)
                        {
                            <div class="form-label small text-muted mb-1" id="spool-storage-options">@L["spool.storage"]</div>
                            <div class="spool-choice-buttons mb-2" role="group" aria-labelledby="spool-storage-options">
                                @foreach (var s in _storages)
                                {
                                    <button type="button" class="btn spool-choice-button @(_form.StorageLocationId == s.Id ? "btn-primary" : "btn-outline-secondary")"
                                            aria-pressed="@((_form.StorageLocationId == s.Id).ToString().ToLowerInvariant())" @onclick='() => OnLocationChange("storage", s.Id)'>
                                        <i class="bi bi-check-lg spool-choice-check" style="visibility:@(_form.StorageLocationId == s.Id ? "visible" : "hidden")" aria-hidden="true"></i>
                                        <span>@s.Name</span>
                                    </button>
                                }
                            </div>
                        }
                        @if (_dryerList.Count > 0)
                        {
                            <div class="form-label small text-muted mb-1" id="spool-dryer-options">@L["spool.dryer"]</div>
                            <div class="spool-choice-buttons" role="group" aria-labelledby="spool-dryer-options">
                                @foreach (var d in _dryerList)
                                {
                                    <button type="button" class="btn spool-choice-button @(_form.DryerId == d.Id ? "btn-primary" : "btn-outline-secondary")"
                                            aria-pressed="@((_form.DryerId == d.Id).ToString().ToLowerInvariant())" @onclick='() => OnLocationChange("dryer", d.Id)'>
                                        <i class="bi bi-check-lg spool-choice-check" style="visibility:@(_form.DryerId == d.Id ? "visible" : "hidden")" aria-hidden="true"></i>
                                        <span>@d.Name</span>
                                    </button>
                                }
                            </div>
                        }
                    </fieldset>

                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label">@L["spool.purchased"] @L["common.optional"]</label>
                            <input class="form-control" type="date" @bind="_form.PurchasedAt" />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label">@L["spool.price"] @L["common.optional"]</label>
                            <input class="form-control" type="number" step="0.01" min="0" @bind="_form.PurchasePrice" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">@L["spool.rfid"] @L["common.optional"]</label>
                        <input class="form-control font-monospace" @bind="_form.RfidTagUid" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@L["spool.reorder"] @L["common.optional"]</label>
                        <input class="form-control" type="url" @bind="_form.ReorderUrl" />
                    </div>
                    <fieldset class="mb-3 spool-choice-fieldset">
                        <legend class="form-label">@L["spool.owner"]</legend>
                        <div class="spool-choice-buttons">
                            <button type="button" class="btn spool-choice-button @(!_form.OwnerId.HasValue ? "btn-primary" : "btn-outline-secondary")"
                                    aria-pressed="@((!_form.OwnerId.HasValue).ToString().ToLowerInvariant())" @onclick="() => _form.OwnerId = null">
                                <i class="bi bi-check-lg spool-choice-check" style="visibility:@(!_form.OwnerId.HasValue ? "visible" : "hidden")" aria-hidden="true"></i>
                                <span>@L["owner.unassigned"]</span>
                            </button>
                            @foreach (var owner in _owners)
                            {
                                <button type="button" class="btn spool-choice-button @(_form.OwnerId == owner.Id ? "btn-primary" : "btn-outline-secondary")"
                                        aria-pressed="@((_form.OwnerId == owner.Id).ToString().ToLowerInvariant())" @onclick="() => _form.OwnerId = owner.Id">
                                    <i class="bi bi-check-lg spool-choice-check" style="visibility:@(_form.OwnerId == owner.Id ? "visible" : "hidden")" aria-hidden="true"></i>
                                    <span>@owner.Name</span>
                                </button>
                            }
                        </div>
                        <a class="form-text d-inline-block py-2" href="/owners">@L["owner.manage"]</a>
                    </fieldset>
                    <div class="mb-3">
                        <label class="form-label">@L["spool.notes"] @L["common.optional"]</label>
                        <textarea class="form-control" rows="3" @bind="_form.Notes"></textarea>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">
                            @if (_saving) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            @L["common.save"]
                        </button>
                        <a href="/spools" class="btn btn-secondary">@L["common.cancel"]</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

