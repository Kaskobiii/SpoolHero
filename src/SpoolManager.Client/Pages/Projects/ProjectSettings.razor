@page "/projects/{Id:guid}/settings"
<PageTitle>@L["project.settings"] – @L["app.name"]</PageTitle>
<div class="page-header"><h1><i class="bi bi-gear me-2"></i>@L["project.settings"]</h1></div>
@if (_loading) { <div class="spinner-border" role="status"></div> }
else if (_project != null)
{
    <div class="card" style="max-width:700px"><div class="card-body">
        @if (_error != null) { <div class="alert alert-danger" role="alert">@_error</div> }
        @if (_saved) { <div class="alert alert-success" role="status">@L["common.success"]</div> }
        <form @onsubmit="SaveAsync" @onsubmit:preventDefault>
            <label for="shared-project-name" class="form-label">@L["project.name"]</label>
            <input id="shared-project-name" class="form-control mb-3" @bind="_project.Name" required maxlength="200" />
            <label for="shared-project-description" class="form-label">@L["project.description"]</label>
            <textarea id="shared-project-description" class="form-control mb-3" @bind="_project.Description" maxlength="2000"></textarea>
            <div class="d-flex gap-2"><button type="submit" class="btn btn-primary" disabled="@_saving">@L["common.save"]</button><a href="/projects" class="btn btn-secondary">@L["common.cancel"]</a></div>
        </form>
    </div></div>
}
